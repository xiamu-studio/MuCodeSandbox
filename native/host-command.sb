(version 1)
(deny default)
(allow file-read-metadata)
(allow file-read-data
  (literal "/")
  (literal (param "PROGRAM"))
  (subpath (param "ROOT"))
  (subpath "/System/Library")
  (subpath "/usr/lib")
  (literal "/dev/null")
  (literal "/dev/urandom"))
(allow file-write-data (literal "/dev/null"))
(allow process-exec (literal (param "PROGRAM")))
(allow process-fork)
(allow process-info* (target self))
(allow sysctl-read)
