  "build": {
    "appId": "local.mucodesandbox.app",
    "productName": "MuCodeSandbox",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "native/bin/**/*",
      "dist/**/*",
      "dist-server/**/*",
      "build-info.json",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/stun/src/node_modules",
        "to": "app/node_modules/stun/src/node_modules",
        "filter": [
          "**/*.js"
        ]
      },
      {
        "from": "node_modules/binary-data/src/node_modules",
        "to": "app/node_modules/binary-data/src/node_modules",
        "filter": [
          "**/*.js",
          "!**/__mocks__/**"
        ]
      }
    ],
    "asar": false,
    "npmRebuild": false,
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false
    }
  }
